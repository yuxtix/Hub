-- Obtener objeto base seguro a partir de texto (MEJORADO)
local function GetRootFromPath(pathStr)
    if not pathStr or pathStr == "" then return workspace end
    if pathStr:lower() == "game" then return game end
    if pathStr:lower() == "workspace" then return workspace end
    
    -- Si es una palabra simple sin puntos, intentamos buscar el Servicio directamente
    if not string.find(pathStr, "%.") then
        local success, result = pcall(function() return game:GetService(pathStr) end)
        if success and typeof(result) == "Instance" then return result end
    end
    
    -- Analizar la ruta secuencialmente (ej. "workspace.Map.Model")
    local parts = string.split(pathStr, ".")
    local current = game
    
    local firstPart = parts[1]:lower()
    if firstPart == "game" then
        table.remove(parts, 1)
    elseif firstPart == "workspace" then
        current = workspace
        table.remove(parts, 1)
    else
        -- Intentar resolver el primer elemento como un servicio
        local success, result = pcall(function() return game:GetService(parts[1]) end)
        if success and typeof(result) == "Instance" then
            current = result
            table.remove(parts, 1)
        end
    end

    -- Navegar jerárquicamente por los hijos
    for _, partName in ipairs(parts) do
        if current == nil then break end
        -- Se usa pcall por si algún objeto bloquea el indexado
        local success, child = pcall(function() return current:FindFirstChild(partName) end)
        if success and child then
            current = child
        else
            current = nil
            break
        end
    end

    if current then return current end
    
    -- Intento final por loadstring (Para casos excepcionales, si el executor lo soporta)
    local fallbackSuccess, fallbackResult = pcall(function()
        return loadstring("return " .. pathStr)()
    end)
    if fallbackSuccess and typeof(fallbackResult) == "Instance" then
        return fallbackResult
    end
    
    return nil
end

-- Limpiar elementos de la interfaz de resultados
local function ClearResultsUI()
    for _, obj in pairs(State.ResultObjects) do
        pcall(function() obj:Destroy() end)
    end
    State.ResultObjects = {}
end

-- Obtener la ruta completa de un objeto
local function GetFullPath(obj)
    local path = obj.Name
    local parent = obj.Parent
    while parent and parent ~= game do
        path = parent.Name .. "." .. path
        parent = parent.Parent
    end
    return "game." .. path
end

-- Verificador de filtros
local function MatchesFilters(inst, depth)
    -- Límite de profundidad
    if State.MaxDepth > 0 and depth > State.MaxDepth then return false end
    
    -- Nombre
    if State.Query ~= "" then
        local nameLower = inst.Name:lower()
        local queryLower = State.Query:lower()
        local nameExact = inst.Name
        local queryExact = State.Query

        if State.SearchMode == "Exacto (Ignorar Mayús)" and nameLower ~= queryLower then return false end
        if State.SearchMode == "Exacto (Sensible Mayús)" and nameExact ~= queryExact then return false end
        if State.SearchMode == "Contiene" and not string.find(nameLower, queryLower, 1, true) then return false end
        if State.SearchMode == "No Contiene" and string.find(nameLower, queryLower, 1, true) then return false end
        if State.SearchMode == "Empieza" and not string.match(nameLower, "^" .. queryLower) then return false end
        if State.SearchMode == "Termina" and not string.match(nameLower, queryLower .. "$") then return false end
        
        -- Wildcard (*): Convierte "Part*Base" en "^part.*base$"
        if State.SearchMode == "Wildcard (*)" then
            -- Escapar caracteres mágicos excepto el asterisco
            local safeQuery = string.gsub(queryLower, "[%(%)%.%%%+%-%?%[%]%^%$]", "%%%1")
            local pattern = "^" .. string.gsub(safeQuery, "%*", ".*") .. "$"
            if not string.match(nameLower, pattern) then return false end
        end

        if State.SearchMode == "Lua Pattern" then
            local s, m = pcall(function() return string.match(nameExact, State.Query) end)
            if not s or not m then return false end
        end
    end
    
    -- Clase
    if State.ClassName ~= "" and inst.ClassName ~= State.ClassName then return false end
    
    -- Exclusiones de Clase
    if State.ExcludeClasses ~= "" then
        local excluded = string.split(State.ExcludeClasses, ",")
        for _, ex in ipairs(excluded) do
            if inst.ClassName == ex:match("^%s*(.-)%s*$") then return false end
        end
    end
    
    -- Cantidad de hijos
    local childrenCount = #inst:GetChildren()
    if State.RequireChildren and childrenCount == 0 then return false end
    if childrenCount < State.MinChildren then return false end
    if childrenCount > State.MaxChildren then return false end
    
    -- Propiedades dinámicas
    if State.CheckProperties and State.PropName ~= "" then
        local success, val = pcall(function() return inst[State.PropName] end)
        if not success then return false end
        if State.PropValue ~= "" and tostring(val) ~= State.PropValue then return false end
    end
    
    return true
end

