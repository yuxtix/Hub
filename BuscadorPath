-- Renderizador de resultados en UI (Paginado / Limite para no crashear)
local function RenderResults()
    ClearResultsUI()
    local total = #State.Results
    local startIdx = ((State.CurrentPage - 1) * State.MaxResultsUI) + 1
    local endIdx = math.min(startIdx + State.MaxResultsUI - 1, total)
    
    if total == 0 then
        local p = TabResults:Paragraph({
            Title = "Sin resultados",
            Desc = "Ajusta tus filtros y vuelve a buscar.",
        })
        table.insert(State.ResultObjects, p)
        return
    end

    local info = TabResults:Paragraph({
        Color = "Green",
        Title = "Resultados (" .. startIdx .. " - " .. endIdx .. " de " .. total .. ")",
        Desc = "Página " .. State.CurrentPage,
    })
    table.insert(State.ResultObjects, info)

    for i = startIdx, endIdx do
        local obj = State.Results[i]
        local successPath, fullPath = pcall(function() return GetFullPath(obj) end)
        if not successPath then fullPath = "Ruta inaccesible" end

        local successChild, childCount = pcall(function() return #obj:GetChildren() end)
        if not successChild then childCount = 0 end

        local p = TabResults:Paragraph({
            Title = obj.Name .. " [" .. obj.ClassName .. "]",
            Desc = "Ruta: " .. fullPath .. "\nHijos: " .. tostring(childCount),
            Buttons = {
                {
                    Icon = "copy",
                    Title = "Copiar Ruta",
                    Callback = function()
                        setclipboard(fullPath)
                        WindUI:Notify({ Title = "Copiado", Content = "Ruta copiada al portapapeles" })
                    end,
                },
                {
                    Icon = "code",
                    Title = "Imprimir",
                    Callback = function()
                        print("==== OBJETO ENCONTRADO ====")
                        print("Nombre:", obj.Name)
                        print("Clase:", obj.ClassName)
                        print("Ruta:", fullPath)
                        print("Referencia:", obj)
                        WindUI:Notify({ Title = "Impreso", Content = "Información enviada a la consola (F9)" })
                    end,
                }
            }
        })
        table.insert(State.ResultObjects, p)
    end
end

-- Motor de búsqueda (BFS Iterativo)
local function StartSearch()
    local rootObj = GetRootFromPath(State.RootPath)
    if not rootObj then
        WindUI:Notify({ Title = "Error", Content = "Ruta raíz inválida o inaccesible", Icon = "x-circle", Duration = 3 })
        return
    end

    State.IsSearching = true
    State.Results = {}
    State.CurrentPage = 1
    ClearResultsUI()

    WindUI:Notify({ Title = "Buscando...", Content = "Analizando desde: " .. State.RootPath, Duration = 3 })

    task.spawn(function()
        local queue = {{obj = rootObj, depth = 0}}
        local batchCounter = 0
        local startTime = tick()

        while #queue > 0 and State.IsSearching do
            local currentItem = table.remove(queue, 1)
            local currentObj = currentItem.obj
            local currentDepth = currentItem.depth

            -- No evaluar el root si el usuario busca algo específico (opcional), pero por ahora lo evaluamos
            if currentObj ~= game and MatchesFilters(currentObj, currentDepth) then
                table.insert(State.Results, currentObj)
            end

            -- Obtener hijos seguro
            local success, children = pcall(function() return currentObj:GetChildren() end)
            if success then
                for _, child in ipairs(children) do
                    table.insert(queue, {obj = child, depth = currentDepth + 1})
                end
            end

            -- Control de rendimiento
            batchCounter = batchCounter + 1
            if batchCounter >= State.BatchSize then
                batchCounter = 0
                task.wait(State.YieldTime)
            end
        end

        State.IsSearching = false
        local timeTaken = math.floor((tick() - startTime) * 100) / 100

        WindUI:Notify({ 
            Title = "Búsqueda Finalizada", 
            Content = "Se encontraron " .. #State.Results .. " objetos en " .. timeTaken .. "s.", 
            Icon = "check-circle", 
            Duration = 5 
        })
        
        RenderResults()
        Window:SelectTab(3) -- Salto automático a Resultados
    end)
end

TabSearch:Button({
